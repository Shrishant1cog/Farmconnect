# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:3001
JWT_SECRET=super_secret_farmconnect_jwt_key_998877665544332211
JWT_EXPIRES_IN=7d

# Database (PostgreSQL — local docker-compose or managed production database)
DATABASE_URL="postgresql://farmconnect:farmconnect@localhost:5432/farmconnect?schema=public"

# Next.js Client
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Object storage for uploaded images.
# The local disk is fine for development, but production deployments MUST use an
# S3-compatible bucket because a Render web service has an ephemeral filesystem.
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_URL=

# Firebase Admin (optional — required only for Firebase phone OTP sign-in)
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=
