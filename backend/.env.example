# Copy this file to `backend/.env` when running the API from the `backend/` folder.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:3001
JWT_SECRET=super_secret_farmconnect_jwt_key_998877665544332211
JWT_EXPIRES_IN=7d

# PostgreSQL connection string (docker compose service or managed database)
DATABASE_URL="postgresql://farmconnect:farmconnect@localhost:5432/farmconnect?schema=public"

# Object storage for uploaded images (S3-compatible). Optional in development.
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_URL=

# Firebase Admin (optional — only needed for Firebase phone OTP sign-in)
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=
